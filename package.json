{
  "name": "points-chauds-france",
  "version": "0.0.1",
  "description": "Carte des points chauds détectés par satellite en France (NASA FIRMS)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "validate-config": "node scripts/validate-geojson.mjs",
    "validate-docs": "bash scripts/validate-docs.sh",
    "discover-dataset": "node scripts/discover-dataset.mjs",
    "fetch-firms": "node scripts/fetch-firms.mjs",
    "generate": "python scripts/generate-config.py",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet-atlas": "^0.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "^1.9.22",
    "eslint": "^10.9.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
